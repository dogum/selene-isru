{
  "name": "@selene-isru/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "gen:constants": "node scripts/gen-constants.ts",
    "check:constants": "node scripts/gen-constants.ts && git diff --exit-code -- src/constants.ts",
    "build": "pnpm gen:constants && tsc -p tsconfig.json && node scripts/check-size.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
